# Copy this file to .env and fill in your real values. Never commit .env.

# --- Symbols (legacy fallback — engine now scans dynamically) ---
DELTA_SYMBOL=BTCUSD
BINANCE_SYMBOL=BTCUSDT
BYBIT_SYMBOL=BTCUSDT

# --- Multi-coin scanning ---
# JSON list of base assets to scan, e.g. '["BTC","ETH","SOL"]'
# Leave empty to use default whitelist from config/constants.py
COIN_WHITELIST=
# Set to "true" to scan ALL perpetuals (ignores whitelist)
SCAN_ALL_COINS=false

# --- Sizing ---
# Fixed notional per trade in INR (set to 0 to use TRADE_QUANTITY instead)
FIXED_NOTIONAL_INR=10000
TRADE_QUANTITY=0.001
REQUESTED_LEVERAGE=10
MAIN_LOOP_INTERVAL_SEC=10

# --- Strategy economics ---
# Minimum net edge (%) per snapshot, after amortized costs, required to enter.
# Lower it (even negative) in paper mode to force more trades for testing.
MIN_NET_EDGE_PCT=0.05
# Funding arb only profits if the position is HELD across several snapshots so
# entry/exit fees amortize. This is how many snapshots we expect to hold — it
# both amortizes cost in the entry decision AND caps the hold length.
EXPECTED_HOLD_SNAPSHOTS=8
# While holding, exit early if the live net funding edge (%) drops below this.
FUNDING_EXIT_THRESHOLD_PCT=0.0

# --- Delta Exchange India ---
DELTA_API_KEY=
DELTA_API_SECRET=

# --- Binance Futures (USDⓈ-M) ---
# Public market data (symbols, funding rates, prices) works WITHOUT keys.
# API keys required only for trading (orders, positions, leverage).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Bybit (V5 Linear Perpetuals) ---
# Public market data (symbols, funding rates, prices) works WITHOUT keys.
# API keys required only for trading (orders, positions, leverage).
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# --- Simulator only ---
SIM_STARTING_BALANCE_INR=100000
