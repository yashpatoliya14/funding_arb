# Copy this file to .env and fill in your real values. Never commit .env.

# --- Symbols (legacy fallback — engine now scans dynamically) ---
DELTA_SYMBOL=BTCUSD
COINSWITCH_SYMBOL=BTCUSDT
SHARK_SYMBOL=BTCUSDT

# --- Multi-coin scanning ---
# JSON list of base assets to scan, e.g. '["BTC","ETH","SOL"]'
# Leave empty to use default whitelist from config/constants.py
COIN_WHITELIST=
# Set to "true" to scan ALL perpetuals (ignores whitelist)
SCAN_ALL_COINS=false

# --- Sizing ---
# Fixed notional per trade in INR (set to 0 to use TRADE_QUANTITY instead)
FIXED_NOTIONAL_INR=10000
TRADE_QUANTITY=0.001
REQUESTED_LEVERAGE=10
MAIN_LOOP_INTERVAL_SEC=10

# --- Delta Exchange India ---
DELTA_API_KEY=
DELTA_API_SECRET=

# --- CoinSwitch PRO ---
COINSWITCH_API_KEY=
COINSWITCH_API_SECRET=

# --- Shark Exchange ---
SHARK_API_KEY=
SHARK_API_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# --- Simulator only ---
SIM_STARTING_BALANCE_INR=100000
